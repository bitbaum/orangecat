{
  "name": "@bitbaum/deckkit",
  "version": "0.1.0",
  "description": "Presentations as data: a deck model, a generator that drafts one from what a project already says, live-bound numbers, and one renderer — 16:9 at any size, keyboard/swipe, deep links, print to PDF.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/orangecat.git",
    "directory": "packages/deckkit"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "src",
    "styles.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
