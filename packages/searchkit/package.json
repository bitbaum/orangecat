{
  "name": "@bitbaum/searchkit",
  "version": "0.2.1",
  "description": "Search that finds what was meant: typo budgets by word length, prefix while typing, German spellings without umlauts, joined and split words, Algolia-order tie-break ranking, highlight ranges, query expansion for any database, and a generated typo regression suite. Zero dependencies; React optional.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/orangecat.git",
    "directory": "packages/searchkit"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  }
}
